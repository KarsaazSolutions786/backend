# ---- Dockerfile Snippet for Serving 8-bit Bloom ----

# NOTE: vLLM does not natively support loading 8-bit models quantized with bitsandbytes.
# The command below is a placeholder demonstrating a potential setup if support were available
# or if using a different inference server like Text Generation Inference (TGI) that
# does support bitsandbytes quantization. For vLLM, you would typically use formats
# like AWQ or GPTQ.

# 1. Copy local quantized model weights into the Docker image
COPY bloom-560m-8bit /models/bloom-560m-8bit

# 2. Command to serve the model with vLLM's OpenAI-compatible endpoint
# The `--quantization` argument would need to be adjusted for a vLLM-compatible format.
# 'q8_0' is not a valid option for vLLM's --quantization flag.
CMD ["python", "-m", "vllm.entrypoints.openai.api_server", \
     "--model", "/models/bloom-560m-8bit", \
     "--quantization", "awq", \
     "--host", "0.0.0.0", "--port", "8000"] 