# Reminder Service Environment Variables for Railway

# Database Configuration (Railway will provide this)
DATABASE_URL=postgresql://user:password@host:5432/database

# JWT Configuration
JWT_SECRET=your-super-secure-production-jwt-secret-change-this
ALGORITHM=HS256

# Environment Configuration
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# CORS Configuration - UPDATE WITH YOUR DOMAINS
ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# Redis Configuration (if using Railway Redis)
REDIS_URL=redis://host:port

# RabbitMQ Configuration (if using Railway RabbitMQ)
RABBITMQ_URL=amqp://user:password@host:5672/

# Auth Service URL - UPDATE WITH YOUR AUTH SERVICE URL
AUTH_SERVICE_URL=https://your-auth-service.railway.app

# Service Configuration
SERVICE_NAME=reminder-service
SERVICE_VERSION=1.0.0

# Security Configuration
HSTS_ENABLED=true
CONTENT_SECURITY_POLICY_ENABLED=true

# Performance Configuration
MAX_WORKERS=4
TIMEOUT_SECONDS=30

# Feature Flags
ENABLE_HEALTH_CHECKS=true 