# Auth Service Environment Variables for Railway

# Database Configuration (Railway will provide this)
DATABASE_URL=postgresql://postgres:LznmUUXFYBTxDdKiZQevSnLTPUxYSmbA@postgres.railway.internal:5432/eindr_db

# JWT Configuration - CHANGE THESE FOR PRODUCTION!
SECRET_KEY=your-super-secure-production-secret-key-change-this
JWT_SECRET=your-super-secure-production-jwt-secret-change-this
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Environment Configuration
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# CORS Configuration - UPDATE WITH YOUR DOMAINS
ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# Redis Configuration (if using Railway Redis)
REDIS_URL=redis://host:port

# Service Configuration
SERVICE_NAME=auth-service
SERVICE_VERSION=1.0.0

# Security Configuration
HSTS_ENABLED=true
CONTENT_SECURITY_POLICY_ENABLED=true
BCRYPT_ROUNDS=12
SESSION_TIMEOUT_MINUTES=60
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=30

# Performance Configuration
MAX_WORKERS=4
TIMEOUT_SECONDS=30

# Feature Flags
ENABLE_HEALTH_CHECKS=true 