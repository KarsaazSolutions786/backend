# Track heavy ML artefacts with Git LFS
*.bin           filter=lfs diff=lfs merge=lfs -text
*.onnx          filter=lfs diff=lfs merge=lfs -text
*.safetensors   filter=lfs merge=lfs -text
*.lock          filter=lfs diff=lfs merge=lfs -text
*.pt            filter=lfs diff=lfs merge=lfs -text
*.pth           filter=lfs diff=lfs merge=lfs -text

# Track large blob files in model directories
models/**/blobs/* filter=lfs diff=lfs merge=lfs -text
models/**/snapshots/*/blobs/* filter=lfs diff=lfs merge=lfs -text
models/whisper/*.pt filter=lfs diff=lfs merge=lfs -text
models/whisper-tiny.bin filter=lfs diff=lfs merge=lfs -text
models/Mini_LM.bin filter=lfs diff=lfs merge=lfs -text
