# ========================================
# RAILWAY DEPLOYMENT - ENVIRONMENT CONFIGURATION
# ========================================

# ========================================
# RAILWAY DYNAMIC CONFIGURATION
# ========================================
# PORT is automatically set by Railway - DO NOT SET MANUALLY
# Railway will inject: PORT=random_port_number

# ========================================
# DATABASE CONFIGURATION (Railway PostgreSQL)
# ========================================
# Railway automatically provides DATABASE_URL - use their variable
# DATABASE_URL=postgresql://user:pass@host:port/db (set by Railway)

# ========================================
# JWT & AUTHENTICATION CONFIGURATION
# ========================================
SECRET_KEY=eindr-super-secure-jwt-secret-key-for-production-2024-v1
JWT_SECRET=eindr-super-secure-jwt-secret-key-for-production-2024-v1
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ========================================
# ENVIRONMENT CONFIGURATION
# ========================================
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
LOG_SENSITIVE_DATA=false

# ========================================
# CORS CONFIGURATION (Update with your domain)
# ========================================
ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# ========================================
# REDIS CONFIGURATION (Railway Redis)
# ========================================
# Railway automatically provides REDIS_URL - use their variable
# REDIS_URL=redis://user:pass@host:port (set by Railway)

# ========================================
# RABBITMQ CONFIGURATION (Railway RabbitMQ)
# ========================================
# Railway automatically provides RABBITMQ_URL - use their variable
# RABBITMQ_URL=amqp://user:pass@host:port (set by Railway)

# ========================================
# SERVICE CONFIGURATION
# ========================================
SERVICE_NAME=customer-service
SERVICE_VERSION=1.0.0

# ========================================
# INTER-SERVICE COMMUNICATION URLs
# ========================================
# Update these with your actual Railway service URLs
AUTH_SERVICE_URL=https://auth-production-37f1.up.railway.app
CUSTOMER_SERVICE_URL=https://customers-production-c75c.up.railway.app
REMINDER_SERVICE_URL=https://reminder-service-production.up.railway.app
NOTE_SERVICE_URL=https://note-service-production.up.railway.app
LEDGER_SERVICE_URL=https://ledger-service-production.up.railway.app
FRIEND_SERVICE_URL=https://friend-service-production.up.railway.app
HISTORY_SERVICE_URL=https://history-service-production.up.railway.app
CHAT_SERVICE_URL=https://chat-service-production-86e0.up.railway.app
SCHEDULER_SERVICE_URL=https://scheduler-service-production-4dd1.up.railway.app
STT_SERVICE_URL=https://stt-service-production.up.railway.app
TTS_SERVICE_URL=https://tts-service-production.up.railway.app

# ========================================
# AI MODEL CONFIGURATION
# ========================================
AI_MODELS_PATH=/app/models
BLOOM_MODEL_PATH=/app/models/bloom-560m
WHISPER_MODEL_PATH=/app/models/whisper-tiny.bin
SENTENCE_TRANSFORMER_MODEL_PATH=/app/models/all-MiniLM-L6-v2
XTTS_MODEL_PATH=/app/models/coqui_xtts_v2
COQUI_TOS_AGREED=1

# ========================================
# PERFORMANCE CONFIGURATION
# ========================================
MODEL_CACHE_SIZE=2
MAX_WORKERS=4
TIMEOUT_SECONDS=30

# ========================================
# FEATURE FLAGS
# ========================================
ENABLE_MODEL_CACHING=true
ENABLE_PROMETHEUS_METRICS=true
ENABLE_HEALTH_CHECKS=true
RATE_LIMITING_ENABLED=true

# ========================================
# SECURITY CONFIGURATION
# ========================================
SECURITY_HEADERS_ENABLED=true
HSTS_ENABLED=true
CONTENT_SECURITY_POLICY_ENABLED=true
BCRYPT_ROUNDS=12
SESSION_TIMEOUT_MINUTES=60
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=30

# ========================================
# EMAIL CONFIGURATION
# ========================================
SMTP_HOST=your-smtp-host.com
SMTP_PORT=587
SMTP_USERNAME=your-email@domain.com
SMTP_PASSWORD=your-email-password
SMTP_USE_TLS=true
EMAIL_FROM=noreply@yourdomain.com

# ========================================
# FILE UPLOAD CONFIGURATION
# ========================================
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=pdf,doc,docx,txt,md,jpg,jpeg,png,gif,wav,mp3,mp4

# ========================================
# PAGINATION CONFIGURATION
# ========================================
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# ========================================
# MONITORING CONFIGURATION
# ========================================
PROMETHEUS_ENABLED=true
GRAFANA_ENABLED=true
HEALTH_CHECK_INTERVAL=30s
HEALTH_CHECK_TIMEOUT=10s
HEALTH_CHECK_RETRIES=3

# ========================================
# PRODUCTION SECURITY REMINDERS
# ========================================
# IMPORTANT: Change these values in Railway dashboard!
# JWT_SECRET=<generate-strong-random-secret>
# ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
# ENVIRONMENT=production
# DEBUG=false
# LOG_LEVEL=INFO
# HSTS_ENABLED=true
# CONTENT_SECURITY_POLICY_ENABLED=true