# Railway Production Environment Variables Template
# Copy this to railway.env and fill in your actual values

# Database Configuration (Railway will provide this)
DATABASE_URL=postgresql://user:password@host:5432/database

# JWT Configuration - CHANGE THESE FOR PRODUCTION!
SECRET_KEY=your-super-secure-production-secret-key-change-this
JWT_SECRET=your-super-secure-production-jwt-secret-change-this
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Environment Configuration
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# CORS Configuration - UPDATE WITH YOUR DOMAINS
ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# Redis Configuration (if using Railway Redis)
REDIS_URL=redis://host:port

# Microservice URLs - UPDATE WITH YOUR ACTUAL SERVICE URLs
AUTH_SERVICE_URL=https://your-auth-service.railway.app
CUSTOMER_SERVICE_URL=https://your-customer-service.railway.app
REMINDER_SERVICE_URL=https://your-reminder-service.railway.app
NOTE_SERVICE_URL=https://your-note-service.railway.app
LEDGER_SERVICE_URL=https://your-ledger-service.railway.app
FRIEND_SERVICE_URL=https://your-friend-service.railway.app
CHAT_SERVICE_URL=https://your-chat-service.railway.app

# AI Model Configuration
AI_MODELS_PATH=/app/models
BLOOM_MODEL_PATH=/app/models/bloom-560m
WHISPER_MODEL_PATH=/app/models/whisper-tiny.bin
SENTENCE_TRANSFORMER_MODEL_PATH=/app/models/all-MiniLM-L6-v2
XTTS_MODEL_PATH=/app/models/coqui_xtts_v2

# Service Configuration
SERVICE_NAME=eindr-microservice
SERVICE_VERSION=1.0.0

# Security Configuration
HSTS_ENABLED=true
CONTENT_SECURITY_POLICY_ENABLED=true
BCRYPT_ROUNDS=12
SESSION_TIMEOUT_MINUTES=60
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=30

# Performance Configuration
MODEL_CACHE_SIZE=2
MAX_WORKERS=4
TIMEOUT_SECONDS=30

# Feature Flags
ENABLE_MODEL_CACHING=true
ENABLE_PROMETHEUS_METRICS=false
ENABLE_HEALTH_CHECKS=true

# File Upload Configuration
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=pdf,doc,docx,txt,md,jpg,jpeg,png,gif,wav,mp3,mp4

# Pagination Configuration
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100 