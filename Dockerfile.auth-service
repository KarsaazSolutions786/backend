FROM python:3.11-slim

# Set the working directory
WORKDIR /app

# Install system dependencies in one layer to reduce size
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Copy auth-service requirements
COPY services/auth-service/requirements.txt .

# Install Python dependencies with timeout and no cache
RUN pip install --no-cache-dir --timeout=1000 -r requirements.txt

# Copy auth-service code
COPY services/auth-service/run.py .
COPY services/auth-service/src/ ./src/
COPY services/auth-service/migrations/ ./migrations/
COPY services/auth-service/alembic.ini .

# Make run script executable
RUN chmod +x run.py

# Set environment variables
ENV PYTHONPATH=/app
ENV PORT=8000

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=30s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Start the application using the run script
CMD ["python", "run.py"] 