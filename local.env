# Local Development Environment Variables
# =====================================
# Use these when running services locally with the containerized PostgreSQL

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=eindr_user
DB_PASSWORD=eindr_pass

# Individual Database URLs for each service
AUTH_DATABASE_URL=postgresql://eindr_user:eindr_pass@localhost:5432/auth_db
USER_DATABASE_URL=postgresql://eindr_user:eindr_pass@localhost:5432/user_db
REMINDER_DATABASE_URL=postgresql://eindr_user:eindr_pass@localhost:5432/reminder_db
NOTE_DATABASE_URL=postgresql://eindr_user:eindr_pass@localhost:5432/note_db
LEDGER_DATABASE_URL=postgresql://eindr_user:eindr_pass@localhost:5432/ledger_db
FRIEND_DATABASE_URL=postgresql://eindr_user:eindr_pass@localhost:5432/friend_db
HISTORY_DATABASE_URL=postgresql://eindr_user:eindr_pass@localhost:5432/history_db
CHAT_DATABASE_URL=postgresql://eindr_user:eindr_pass@localhost:5432/chat_db
SCHEDULER_DATABASE_URL=postgresql://eindr_user:eindr_pass@localhost:5432/scheduler_db

# Redis Configuration
REDIS_URL=redis://localhost:6379

# RabbitMQ Configuration  
RABBITMQ_URL=amqp://eindr:eindr123@localhost:5672/

# Service URLs (for local development)
AUTH_SERVICE_URL=http://localhost:8001
USER_SERVICE_URL=http://localhost:8002
REMINDER_SERVICE_URL=http://localhost:8003
NOTE_SERVICE_URL=http://localhost:8004
LEDGER_SERVICE_URL=http://localhost:8005
FRIEND_SERVICE_URL=http://localhost:8006
HISTORY_SERVICE_URL=http://localhost:8007
STT_SERVICE_URL=http://localhost:8008
TTS_SERVICE_URL=http://localhost:8009
INTENT_SERVICE_URL=http://localhost:8010
CHAT_SERVICE_URL=http://localhost:8011
SCHEDULER_SERVICE_URL=http://localhost:8012

# JWT Configuration
JWT_SECRET=your-local-jwt-secret-key-for-development

# Development Settings
DEBUG=true
ENVIRONMENT=local 